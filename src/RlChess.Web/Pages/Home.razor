@page "/"
@using RlChess.Engine
@using RlChess.Web.Components
@using RlChess.Web.Game

<PageTitle>rlChess</PageTitle>

<TopBar>
    <Actions>
        <button class="btn primary" @onclick="() => _showNewGame = true">New game</button>
    </Actions>
</TopBar>

<main class="game">
    <section class="board-col">
        @PlayerStrip(_orientation.Opponent())
        <ChessBoard Pieces="_tracker.Pieces"
                    Orientation="_orientation"
                    LastMove="ShownLastMove"
                    CheckSquare="CheckSquare"
                    Selected="_selected"
                    Dests="_dests"
                    PremoveDests="_destsArePremove"
                    Premoves="_premoves"
                    HoverSquare="_hoverSquare"
                    HoverDests="_hoverDests"
                    OnHoverCallback="OnHover"
                    MovableColor="MovableColor"
                    Animate="_animate"
                    PositionKey="@HashCode.Combine(_generation, _game.Moves.Count, _viewPly, _inVar, _varPly)"
                    PromotionSquare="@(_pendingPromotion?.To ?? -1)"
                    PromotionColor="_shown.SideToMove"
                    OnPromotion="OnPromotion"
                    OnSquareDownCallback="OnSquareDown"
                    OnSquareUpCallback="OnSquareUp"
                    OnRightClickCallback="OnRightClick" />
        @PlayerStrip(_orientation)
    </section>

    <aside class="side">
        <div class="panel status-panel">
            <div class="mode">@ModeText</div>
            <div class="status @(_game.IsOver ? "over" : "") @(_computerError is null ? "" : "failed")">
                @if (_thinking) { <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span> }
                @StatusText()
            </div>
            @if (_drawOfferBy is Color offerer && !_game.IsOver)
            {
                <div class="offer">
                    <span>@(offerer == Color.White ? "White" : "Black") offers a draw</span>
                    <span class="offer-actions">
                        <button class="btn small primary" @onclick="() => AnswerDraw(true)">Accept</button>
                        <button class="btn small" @onclick="() => AnswerDraw(false)">Decline</button>
                    </span>
                </div>
            }
        </div>

        <div class="panel moves-panel @(_analysing ? "analysing" : "")">
            <div class="nav-buttons">
                <button class="icon-btn" title="First move" disabled="@(!_inVar && _viewPly == 0)" @onclick="() => ShowMain(0)">
                    <svg viewBox="0 0 24 24"><path d="M5 5h2.5v14H5zM19 5l-10 7 10 7z" /></svg>
                </button>
                <button class="icon-btn" title="Previous move (←)" disabled="@(!CanStepBack)" @onclick="StepBack">
                    <svg viewBox="0 0 24 24"><path d="M16 5l-9 7 9 7z" /></svg>
                </button>
                <button class="icon-btn" title="Next move (→)" disabled="@(!CanStepForward)" @onclick="StepForward">
                    <svg viewBox="0 0 24 24"><path d="M8 5l9 7-9 7z" /></svg>
                </button>
                <button class="icon-btn" title="Last move" disabled="@IsLive" @onclick="() => ShowMain(_game.Moves.Count)">
                    <svg viewBox="0 0 24 24"><path d="M16.5 5H19v14h-2.5zM5 5l10 7-10 7z" /></svg>
                </button>
                <button class="analyse-toggle @(_analysing ? "on" : "")" disabled="@(!_analysing && !CanAnalyse)"
                        title="@(_analysing ? "Back to the game" : CanAnalyse ? "Try other moves from any position" : "Analysis is available when the clock game is over")"
                        @onclick="ToggleAnalysis">
                    <svg viewBox="0 0 24 24"><path class="stroke" d="M6 3v12M6 15a3 3 0 1 0 0 6 3 3 0 0 0 0-6zM18 9a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM18 9a9 9 0 0 1-9 9" /></svg>
                    Analyse
                </button>
            </div>
            <div class="move-list" @ref="_moveListEl">
                @if (_game.Moves.Count == 0)
                {
                    <div class="empty">@(_mode == GameMode.ComputerVsComputer ? "The computers are about to start." : IsHuman(_game.SideToMove) ? "Make a move to begin." : "The computer moves first.")</div>
                    @if (_varBase == 0) { @Variation() }
                }
                @foreach (var row in MoveRows())
                {
                    <div class="move-row">
                        <span class="num">@(row.Number).</span>
                        @MoveCell(row.WhitePly)
                        @MoveCell(row.BlackPly)
                    </div>
                    @if (_varBase >= 0 && _game.Moves.Count > 0 && (row.WhitePly == VariationRowPly || row.BlackPly == VariationRowPly))
                    {
                        @Variation()
                    }
                }
                @if (_game.IsOver)
                {
                    <div class="result">
                        <div class="score">@_game.Result.ToPgnString()</div>
                        <div class="reason">@StatusText()</div>
                    </div>
                }
            </div>
            @if (_analysing)
            {
                <button class="back-to-live analysis-bar" @onclick="ToggleAnalysis">Analysis · either side can move · <b>back to the game</b></button>
            }
            else if (!IsLive)
            {
                <button class="back-to-live" @onclick="() => ShowMain(_game.Moves.Count)">Viewing an earlier position · back to the game</button>
            }
        </div>

        <div class="panel controls">
            @if (_game.IsOver && _reviewNote is null)
            {
                <button class="btn primary wide" @onclick="Rematch">Rematch</button>
            }
            @if (_mode == GameMode.ComputerVsComputer)
            {
                <div class="control-row">
                    <button class="btn" disabled="@_game.IsOver" @onclick="TogglePause" title="@(_paused ? "Resume" : "Pause")">
                        @if (_paused)
                        {
                            <svg viewBox="0 0 24 24"><path d="M8 5l11 7-11 7z" /></svg>
                            <span>Play</span>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24"><path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" /></svg>
                            <span>Pause</span>
                        }
                    </button>
                    <button class="btn" @onclick="Flip" title="Flip board (f)">
                        <svg viewBox="0 0 24 24"><path d="M7 4v15M7 19l-3-3M7 19l3-3M17 20V5M17 5l-3 3M17 5l3 3" class="stroke" /></svg>
                        Flip
                    </button>
                    <button class="btn" @onclick="() => _showNewGame = true" title="New game">
                        <svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" class="stroke" /></svg>
                        New
                    </button>
                </div>
                <div class="speed" role="radiogroup" aria-label="Speed">
                    <span class="speed-label">Speed</span>
                    @foreach (var (key, label) in new[] { ("slow", "Slow"), ("normal", "Normal"), ("fast", "Fast") })
                    {
                        <button class="seg small @(_speed == key ? "chosen" : "")" role="radio" aria-checked="@(_speed == key)" @onclick="() => _speed = key">@label</button>
                    }
                </div>
            }
            else
            {
                <div class="control-row">
                    <button class="btn" disabled="@(!CanUndo)" @onclick="Undo" title="@(Clocked ? "No take-backs in games with a clock" : "Take back")">
                        <svg viewBox="0 0 24 24"><path d="M9 14L4 9l5-5M4 9h11a5 5 0 0 1 0 10h-3" class="stroke" /></svg>
                        Undo
                    </button>
                    <button class="btn" @onclick="Flip" title="Flip board (f)">
                        <svg viewBox="0 0 24 24"><path d="M7 4v15M7 19l-3-3M7 19l3-3M17 20V5M17 5l-3 3M17 5l3 3" class="stroke" /></svg>
                        Flip
                    </button>
                    <button class="btn" @onclick="() => _showNewGame = true" title="New game">
                        <svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" class="stroke" /></svg>
                        New
                    </button>
                </div>
                @if (!_game.IsOver && _game.Moves.Count > 0 && !_analysing)
                {
                    <div class="text-actions">
                        @if (_mode == GameMode.TwoPlayers)
                        {
                            <button class="text-btn" disabled="@(_drawOfferBy is not null)" @onclick="OfferDraw"
                                    title="@($"{(_game.SideToMove == Color.White ? "White" : "Black")} offers a draw")">
                                <span class="half-sign">½</span> Offer draw
                            </button>
                        }
                        <button class="text-btn danger" @onclick="Resign" title="@(_mode == GameMode.VsComputer ? "Resign this game" : $"{(_game.SideToMove == Color.White ? "White" : "Black")} resigns")">
                            <svg viewBox="0 0 24 24"><path d="M6 21V4M6 4h11l-2.5 4L17 12H6" class="stroke" /></svg>
                            Resign
                        </button>
                    </div>
                }
            }
        </div>

        <details class="panel tools">
            <summary>Load a game · position · export</summary>
            <label class="field-label" for="pgn">Load a game <span class="hint">(PGN from lichess, chess.com…)</span></label>
            <textarea id="pgn" class="fen-input pgn-input @(_pgnError is null ? "" : "invalid")" rows="3" spellcheck="false"
                      placeholder="Paste a game, e.g. 1. e4 e5 2. Nf3 Nc6" @bind="_pgnInput" @bind:event="oninput"></textarea>
            @if (_pgnError is not null) { <div class="error">@_pgnError</div> }
            <div class="control-row">
                <button class="btn" disabled="@string.IsNullOrWhiteSpace(_pgnInput)" @onclick="LoadPgn">Load PGN</button>
            </div>
            <label class="field-label" for="fen">FEN</label>
            <div class="fen-row">
                <input id="fen" class="fen-input @(_fenError is null ? "" : "invalid")" spellcheck="false" autocomplete="off"
                       @bind="_fenInput" @bind:event="oninput"
                       @onkeydown="@(e => { if (e.Key == "Enter") LoadFen(); })" />
            </div>
            @if (_fenError is not null) { <div class="error">@_fenError</div> }
            <div class="control-row">
                <button class="btn" @onclick="LoadFen" title="Start a new game from this FEN">Load FEN</button>
                <button class="btn" @onclick="CopyFen">Copy FEN</button>
                <button class="btn" @onclick="CopyPgn">Copy PGN</button>
            </div>
            <div class="control-row" style="margin-top: 6px">
                <button class="btn" @onclick="DownloadPgn" title="Save this game as a .pgn file">Download PGN</button>
                <button class="btn" @onclick="EditPosition" title="Open this position in the board editor">Edit position</button>
            </div>
        </details>
    </aside>
</main>

@if (_showNewGame)
{
    <NewGameDialog Setup="_setup" StartFen="_dialogFen" StartFenCleared="() => _dialogFen = null" OnPlay="OnDialogPlay" OnCancel="CancelDialog" />
}

<div class="flash @(_showFlash ? "show" : "")" role="status">@_flash</div>

@code {
    private RenderFragment PlayerStrip(Color side) => __builder =>
    {
        var (extra, score) = MaterialFor(side);
        bool toMove = !_game.IsOver && _game.SideToMove == side && IsLive && !_analysing;
        <div class="player-strip @(toMove ? "to-move" : "")">
            <span class="side-dot @(side == Color.White ? "white" : "black")"></span>
            <span class="player-name">@NameOf(side)</span>
            @if (IsBot(side)) { <span class="tag">computer</span> }
            <span class="material">
                @foreach (var p in extra)
                {
                    <span class="mini piece @ChessBoard.PieceClass(p)"></span>
                }
                @if (score > 0) { <span class="plus">+@score</span> }
            </span>
            @if (_clock is not null)
            {
                <ClockDisplay Clock="_clock" Side="side" />
            }
        </div>
    };

    private RenderFragment MoveCell(int ply) => __builder =>
    {
        if (ply == -2)
        {
            <span class="move empty-move">…</span>
        }
        else if (ply < 0)
        {
            <span class="move empty-move"></span>
        }
        else
        {
            <button class="move @(!_inVar && ply + 1 == _viewPly ? "active" : "")" @onclick="() => ShowMain(ply + 1)">@_game.SanMoves[ply]</button>
        }
    };

    private RenderFragment Variation() => __builder =>
    {
        <div class="variation">
            @foreach (var (i, prefix, san) in VariationMoves())
            {
                @if (prefix.Length > 0) { <span class="var-num">@prefix</span> }
                <button class="var-move @(_inVar && _varPly == i + 1 ? "active" : "")" @onclick="() => ShowVar(i + 1)">@san</button>
            }
        </div>
    };
}
