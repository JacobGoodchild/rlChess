@using Microsoft.AspNetCore.Components.Routing
@implements IDisposable
@inject Prefs Prefs

<header class="topbar">
    <div class="topbar-left">
        <a class="brand" href="./">
            <span class="brand-mark" aria-hidden="true"></span><span>rl<b>Chess</b></span>
        </a>
        <nav class="pages" aria-label="Pages">
            <NavLink href="./" Match="NavLinkMatch.All">Play</NavLink>
            <NavLink href="arena">Arena</NavLink>
            <NavLink href="games">Games</NavLink>
            <NavLink href="editor">Editor</NavLink>
        </nav>
    </div>
    <div class="topnav">
        @Actions
        <div class="menu-anchor">
            <button class="icon-btn" title="Settings" aria-label="Settings" @onclick="() => _showSettings = !_showSettings">
                <svg viewBox="0 0 24 24"><path class="stroke" d="M12 15.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z" /><path class="stroke" d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z" /></svg>
            </button>
            @if (_showSettings)
            {
                <div class="click-away" @onclick="() => _showSettings = false"></div>
                <div class="menu settings-menu" role="dialog" aria-label="Settings">
                    <div class="menu-label">Board</div>
                    <div class="swatches">
                        @foreach (var (name, light, dark) in Settings.BoardThemes)
                        {
                            <button class="swatch swatch-@name @(name == Prefs.BoardTheme ? "chosen" : "")" title="@name" style="--a: @light; --b: @dark"
                                    @onclick="() => Prefs.SetBoardTheme(name)"></button>
                        }
                    </div>
                    <div class="menu-label">Pieces</div>
                    <div class="piece-sets">
                        @foreach (var (id, name, _) in Settings.PieceSets)
                        {
                            <button class="piece-set @(id == Prefs.PieceSet ? "chosen" : "")" title="@name" @onclick="() => Prefs.SetPieceSet(id)">
                                <span class="pieces-@id"><span class="piece wN"></span></span>
                                <span class="set-name">@name</span>
                            </button>
                        }
                    </div>
                    <div class="menu-label">Piece movement</div>
                    <div class="chips-row">
                        @foreach (var (key, label, _) in Settings.AnimationSpeeds)
                        {
                            <button class="chip small @(key == Prefs.Animation ? "chosen" : "")" @onclick="() => Prefs.SetAnimation(key)">@label</button>
                        }
                    </div>
                    <label class="check-row">
                        <input type="checkbox" checked="@Prefs.HoverDots" @onchange="e => Prefs.SetHoverDots(e.Value is true)" />
                        Show moves when hovering over a piece
                    </label>
                    <div class="menu-label">Volume <span class="hint">@(Prefs.Muted ? "(muted)" : $"{Prefs.Volume}%")</span></div>
                    <input class="volume" type="range" min="0" max="100" step="5" value="@Prefs.Volume" aria-label="Volume"
                           @onchange="OnVolume" />
                    <div class="menu-label">Computer think limit <span class="hint">(per move, no clock)</span></div>
                    <div class="chips-row">
                        @foreach (var limit in Settings.ThinkLimits)
                        {
                            <button class="chip small @(limit == Prefs.ThinkLimit ? "chosen" : "")" @onclick="() => Prefs.SetThinkLimit(limit)">@Settings.ThinkLimitLabel(limit)</button>
                        }
                    </div>
                    <details class="advanced">
                        <summary>Advanced <span class="hint">@AdvancedCount</span></summary>
                        @Toggle("Bot thinking", "What a computer reports while it thinks: depth, positions, best line", Prefs.ShowThinking, Prefs.SetShowThinking)
                        @Toggle("Evaluation bar", "Who's better, beside the board", Prefs.EvalBar, Prefs.SetEvalBar)
                        @Toggle("Game review", "Mark every move from Brilliant to Blunder, with accuracy", Prefs.Review, Prefs.SetReview)
                        @Toggle("Opening names", "Name the opening during games", Prefs.OpeningNames, Prefs.SetOpeningNames)
                        @if (Prefs.NeedsAnalysis)
                        {
                            <div class="menu-label">Analysis by</div>
                            <div class="chips-row">
                                <button class="chip small @(Prefs.AnalysisSource == "stockfish" ? "chosen" : "")" @onclick='() => Prefs.SetAnalysisSource("stockfish")'>Stockfish</button>
                                @foreach (var e in AnalysisBots.All)
                                {
                                    <button class="chip small @(Prefs.AnalysisSource == e.Id ? "chosen" : "")" @onclick="() => Prefs.SetAnalysisSource(e.Id)">@e.FullName</button>
                                }
                            </div>
                            <div class="credit">Stockfish (GPLv3, <a href="https://stockfishchess.org" target="_blank" rel="noopener">stockfishchess.org</a>) is downloaded from jsDelivr only while these are on.
                                @if (AnalysisBots.All.Count == 0) { <span>Your own bots appear here once they report a score.</span> }
                            </div>
                        }
                    </details>
                </div>
            }
        </div>
        <button class="icon-btn" title="@(Prefs.Muted ? "Sound off" : "Sound on")" aria-label="Toggle sound" @onclick="() => Prefs.SetMuted(!Prefs.Muted)">
            @if (Prefs.Muted || Prefs.Volume == 0)
            {
                <svg viewBox="0 0 24 24"><path d="M4 9h4l5-4v14l-5-4H4z" /><path d="M17 9l5 6M22 9l-5 6" class="stroke" /></svg>
            }
            else
            {
                <svg viewBox="0 0 24 24"><path d="M4 9h4l5-4v14l-5-4H4z" /><path d="M16.5 8.5a5 5 0 0 1 0 7M19 6a8.5 8.5 0 0 1 0 12" class="stroke" /></svg>
            }
        </button>
        <a class="icon-btn gh" href="https://github.com/JacobGoodchild/rlChess" target="_blank" rel="noopener" title="Source on GitHub" aria-label="Source on GitHub">
            <svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 0 0-3.2 19.5c.5.1.7-.2.7-.5v-1.7c-2.8.6-3.4-1.3-3.4-1.3-.4-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.5 2.3 1.1 2.9.8.1-.6.3-1.1.6-1.3-2.2-.3-4.6-1.1-4.6-5 0-1.1.4-2 1-2.7-.1-.3-.4-1.3.1-2.7 0 0 .8-.3 2.8 1a9.6 9.6 0 0 1 5 0c1.9-1.3 2.7-1 2.7-1 .6 1.4.2 2.4.1 2.7.6.7 1 1.6 1 2.7 0 3.9-2.4 4.7-4.6 5 .4.3.7.9.7 1.9V21c0 .3.2.6.7.5A10 10 0 0 0 12 2z" /></svg>
        </a>
    </div>
</header>

@code {
    /// <summary>Page-specific buttons shown before the settings (e.g. "New game").</summary>
    [Parameter] public RenderFragment? Actions { get; set; }

    private bool _showSettings;

    private string AdvancedCount
    {
        get
        {
            int n = new[] { Prefs.ShowThinking, Prefs.EvalBar, Prefs.Review, Prefs.OpeningNames }.Count(b => b);
            return n == 0 ? "" : $"({n} on)";
        }
    }

    private RenderFragment Toggle(string title, string help, bool on, Func<bool, Task> set) => __builder =>
    {
        <label class="toggle-row">
            <input type="checkbox" role="switch" checked="@on" @onchange="e => set(e.Value is true)" />
            <span class="toggle-text"><span class="toggle-title">@title</span><span class="toggle-help">@help</span></span>
        </label>
    };

    /// <summary>Closes the settings menu (e.g. on Escape).</summary>
    public void CloseMenu() { _showSettings = false; StateHasChanged(); }

    protected override void OnInitialized() => Prefs.Changed += OnChanged;
    private void OnChanged() => InvokeAsync(StateHasChanged);

    private async Task OnVolume(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var v)) return;
        await Prefs.SetVolume(v);
        await Prefs.PlaySound("move");
    }

    public void Dispose() => Prefs.Changed -= OnChanged;
}
